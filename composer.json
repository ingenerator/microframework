{
  "name": "ingenerator/microframework",
  "description": "Extremely lightweight server framework for Cloud Run / Lambda etc",
  "homepage": "https://github.com/ingenerator/microframework",
  "type": "library",
  "require": {
    "php": "~8.5.0",
    "guzzlehttp/psr7": "^2.7 | ^3.2",
    "ingenerator/php-utils": "^3.0",
    "php-cs-fixer/shim": "^3.95"
  },
  "require-dev": {
    "fig/log-test": "^1.1",
    "guzzlehttp/guzzle": "^7.9.1 | ^8.3",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13.4",
    "rector/rector": "2.8.4",
    "symfony/filesystem": "^8.1"
  },
  "license": "BSD-3-Clause",
  "autoload": {
    "psr-4": {
      "Ingenerator\\MicroFramework\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "test\\": "test/"
    }
  },
  "authors": [
    {
      "name": "Andrew Coulton",
      "email": "andrew@ingenerator.com"
    }
  ],
  "support": {
    "source": "https://github.com/ingenerator/microframework",
    "issues": "https://github.com/ingenerator/microframework/issues"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "precommit": [
      "@test:unit",
      "@test:integration",
      "@phpstan",
      "@rector:fix",
      "@cs:fix"
    ],
   "test:unit": "vendor/bin/phpunit --testsuite unit",
   "test:integration": "vendor/bin/phpunit --testsuite integration",
   "test:blackbox": "test/run-blackbox-tests.sh",
   "phpstan": "vendor/bin/phpstan analyse",
   "rector": "vendor/bin/rector process --dry-run",
   "rector:fix": "vendor/bin/rector process",
   "cs": "vendor/bin/php-cs-fixer check --diff",
   "cs:fix": "vendor/bin/php-cs-fixer fix"
  }
}
